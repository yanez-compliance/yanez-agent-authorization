{
  "name": "@yanez/agent-authorization",
  "version": "0.1.0",
  "description": "Yanez agent authorization SDK: request user approval and verify signed receipts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanez-compliance/yanez-agent-authorization.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/yanez-compliance/yanez-agent-authorization#readme",
  "bugs": {
    "url": "https://github.com/yanez-compliance/yanez-agent-authorization/issues"
  },
  "keywords": [
    "yanez",
    "authorization",
    "agent",
    "human-approval",
    "eddsa",
    "jws"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
